# Telegram Bot Token
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Bearer Token for API authentication (optional if API_EMAIL and API_PASSWORD are provided)
# Format: "128621|fAFWiR5z2moso2HIBT7qUr0H3gtMLclkQ9m6O5NXbcc39050"
BEARER_TOKEN=your_bearer_token_here

# API Login Credentials (required for automatic token refresh)
API_ACCOUNT_GROUP=iprnpro
API_EMAIL=your_email_here
API_PASSWORD=your_password_here

# Admin Channel ID for notifications
# Format: -100XXXXXXXXXX for channels, or numeric ID for private chats
ADMIN_CHANNEL_ID=your_admin_channel_id_here
